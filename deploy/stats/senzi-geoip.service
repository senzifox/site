[Unit]
Description=update geolite2 databases from the p3terx mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=goaccess
Group=goaccess
ExecStart=/usr/local/bin/senzi-geoip
StateDirectory=GeoIP
StateDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
