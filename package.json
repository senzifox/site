{
  "name": "site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "avatar": "node scripts/avatar.ts",
    "background": "node scripts/background.ts",
    "tail": "node scripts/tail.ts",
    "icons": "node scripts/icons.ts",
    "fox": "node scripts/fox.ts",
    "spotify:auth": "node --env-file=.env.local scripts/spotify-auth.ts",
    "docker:local": "docker build -f deploy/Dockerfile -t site:local . && IMAGE=site:local docker compose -f deploy/compose.yaml --env-file .env.local up -d"
  },
  "dependencies": {
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "leva": "^0.10.1",
    "potrace": "^2.1.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
